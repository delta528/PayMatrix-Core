pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        AWS_ACCOUNT_ID = '123456789012'
        AWS_REGION     = 'us-east-1'
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "[PayMatrix-Core] Building Commit: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Compile & Unit Tests') {
            parallel {
                stage('Java Tests') {
                    steps {
                        dir('apps/java-backend') {
                            bat 'mvn clean test'
                        }
                    }
                }
                stage('Go Tests') {
                    steps {
                        dir('apps/go-microservice') {
                            bat 'go test -v ./...'
                        }
                    }
                }
                stage('Node.js Tests') {
                    steps {
                        dir('apps/node-frontend') {
                            bat 'npm test'
                        }
                    }
                }
                stage('Python Tests') {
                    steps {
                        dir('apps/python-analytics') {
                            bat 'pytest'
                        }
                    }
                }
            }
        }

        stage('Code Quality & SAST') {
            steps {
                echo "[PayMatrix-Core] Executing SonarQube Analysis..."
                dir('apps/java-backend') {
                    // Uses the SonarQube Server configured under Manage Jenkins -> System
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                echo "[PayMatrix-Core] Building container image for Java Backend..."
                dir('apps/java-backend') {
                    bat "docker build -t paymatrix-java-backend:${env.IMAGE_TAG} ."
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                echo "[PayMatrix-Core] Auditing container image with Trivy..."
                bat "trivy image --severity HIGH,CRITICAL paymatrix-java-backend:${env.IMAGE_TAG}"
            }
        }

        stage('GitOps Deployment Trigger') {
            steps {
                echo "[PayMatrix-Core] Updating k8s-manifests with image tag: ${env.IMAGE_TAG}"
                /*
                bat """
                git config user.name "jenkins-bot"
                git config user.email "jenkins@paymatrix.com"
                git add k8s-manifests/
                git commit -m "chore(gitops): bump image tag to ${env.IMAGE_TAG} [skip ci]"
                git push origin main
                """
                */
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "[PayMatrix-Core] Pipeline succeeded! Code quality and security checks passed."
        }
        failure {
            echo "[PayMatrix-Core] Pipeline failed! Review logs above."
        }
    }
}