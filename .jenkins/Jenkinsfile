pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = '123456789012'
        AWS_REGION     = 'us-east-1'
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    echo "[PayMatrix] Starting Build #${env.IMAGE_TAG}"
                }
            }
        }

        stage('Compile & Unit Tests') {
            parallel {
                stage('Java Tests') {
                    when {
                        changeset "apps/java-backend/**"
                    }
                    steps {
                        dir('apps/java-backend') {
                            bat 'mvn clean test'
                        }
                    }
                }
                stage('Go Tests') {
                    when {
                        changeset "apps/go-microservice/**"
                    }
                    steps {
                        dir('apps/go-microservice') {
                            bat 'go test -v ./...'
                        }
                    }
                }
                stage('Node.js Tests') {
                    when {
                        changeset "apps/node-frontend/**"
                    }
                    steps {
                        dir('apps/node-frontend') {
                            bat 'npm test'
                        }
                    }
                }
                stage('Python Tests') {
                    when {
                        changeset "apps/python-analytics/**"
                    }
                    steps {
                        dir('apps/python-analytics') {
                            bat 'pytest'
                        }
                    }
                }
            }
        }

        stage('Code Quality & SAST') {
            when {
                changeset "apps/java-backend/**"
            }
            steps {
                echo "[PayMatrix] Executing SonarQube Analysis for Java Backend..."
                dir('apps/java-backend') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('SonarQube') {
                            bat 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.host.url=http://127.0.0.1:9000 -Dsonar.token=%SONAR_TOKEN%'
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Java Backend') {
                    when {
                        changeset "apps/java-backend/**"
                    }
                    steps {
                        script {
                            def exists = bat(script: "docker image inspect paymatrix-java-backend:${env.IMAGE_TAG} >nul 2>&1", returnStatus: true) == 0
                            if (exists) {
                                echo "[PayMatrix] Image paymatrix-java-backend:${env.IMAGE_TAG} already exists locally. Skipping build."
                            } else {
                                echo "[PayMatrix] Building paymatrix-java-backend:${env.IMAGE_TAG}..."
                                dir('apps/java-backend') {
                                    bat "docker build -t paymatrix-java-backend:${env.IMAGE_TAG} ."
                                }
                            }
                        }
                    }
                }
                stage('Go Fraud Gateway') {
                    when {
                        changeset "apps/go-microservice/**"
                    }
                    steps {
                        script {
                            def exists = bat(script: "docker image inspect paymatrix-go-fraud:${env.IMAGE_TAG} >nul 2>&1", returnStatus: true) == 0
                            if (exists) {
                                echo "[PayMatrix] Image paymatrix-go-fraud:${env.IMAGE_TAG} already exists locally. Skipping build."
                            } else {
                                echo "[PayMatrix] Building paymatrix-go-fraud:${env.IMAGE_TAG}..."
                                dir('apps/go-microservice') {
                                    bat "docker build -t paymatrix-go-fraud:${env.IMAGE_TAG} ."
                                }
                            }
                        }
                    }
                }
                stage('Node Frontend') {
                    when {
                        changeset "apps/node-frontend/**"
                    }
                    steps {
                        script {
                            def exists = bat(script: "docker image inspect paymatrix-node-frontend:${env.IMAGE_TAG} >nul 2>&1", returnStatus: true) == 0
                            if (exists) {
                                echo "[PayMatrix] Image paymatrix-node-frontend:${env.IMAGE_TAG} already exists locally. Skipping build."
                            } else {
                                echo "[PayMatrix] Building paymatrix-node-frontend:${env.IMAGE_TAG}..."
                                dir('apps/node-frontend') {
                                    bat "docker build -t paymatrix-node-frontend:${env.IMAGE_TAG} ."
                                }
                            }
                        }
                    }
                }
                stage('Python Analytics') {
                    when {
                        changeset "apps/python-analytics/**"
                    }
                    steps {
                        script {
                            def exists = bat(script: "docker image inspect paymatrix-python-analytics:${env.IMAGE_TAG} >nul 2>&1", returnStatus: true) == 0
                            if (exists) {
                                echo "[PayMatrix] Image paymatrix-python-analytics:${env.IMAGE_TAG} already exists locally. Skipping build."
                            } else {
                                echo "[PayMatrix] Building paymatrix-python-analytics:${env.IMAGE_TAG}..."
                                dir('apps/python-analytics') {
                                    bat "docker build -t paymatrix-python-analytics:${env.IMAGE_TAG} ."
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            parallel {
                stage('Scan Java Image') {
                    when {
                        changeset "apps/java-backend/**"
                    }
                    steps {
                        bat "trivy image --severity HIGH,CRITICAL paymatrix-java-backend:${env.IMAGE_TAG}"
                    }
                }
                stage('Scan Go Image') {
                    when {
                        changeset "apps/go-microservice/**"
                    }
                    steps {
                        bat "trivy image --severity HIGH,CRITICAL paymatrix-go-fraud:${env.IMAGE_TAG}"
                    }
                }
                stage('Scan Node Image') {
                    when {
                        changeset "apps/node-frontend/**"
                    }
                    steps {
                        bat "trivy image --severity HIGH,CRITICAL paymatrix-node-frontend:${env.IMAGE_TAG}"
                    }
                }
                stage('Scan Python Image') {
                    when {
                        changeset "apps/python-analytics/**"
                    }
                    steps {
                        bat "trivy image --severity HIGH,CRITICAL paymatrix-python-analytics:${env.IMAGE_TAG}"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "[PayMatrix] Build completed successfully. Unchanged services were skipped automatically."
        }
        failure {
            echo "[PayMatrix] Build failed! Review logs above."
        }
    }
}