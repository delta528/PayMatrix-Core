pipeline {
    agent any

    environment {
        AWS_REGION = 'us-west-2'
        ECR_REGISTRY = '074926209680.dkr.ecr.us-west-2.amazonaws.com'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        SCAN_REPORT_DIR = "${WORKSPACE}\\trivy-reports"
        SONARQUBE_SERVER = 'SonarQube'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
    }

    stages {

        stage('1. Checkout & Setup') {
            steps {
                checkout scm
                script {
                    try {
                        def gitSha = bat(
                            script: '@echo off & git rev-parse --short HEAD', 
                            returnStdout: true
                        ).trim()
                        
                        if (gitSha && gitSha != "null" && !gitSha.contains("cmd.exe")) {
                            env.IMAGE_TAG = gitSha
                        }
                    } catch (Exception e) {
                        echo "[Warning] Could not get Git SHA. Falling back to BUILD_NUMBER."
                    }

                    echo "[PayMatrix Production] Target Image Tag: ${env.IMAGE_TAG}"
                    bat "if not exist \"${env.SCAN_REPORT_DIR}\" mkdir \"${env.SCAN_REPORT_DIR}\""
                }
            }
        }

        stage('2. SonarQube Code Quality') {
            parallel {
                stage('Sonar: Java Backend') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\java-backend:/usr/src/mymaven" ^
                                            -v "%USERPROFILE%\\.m2:/root/.m2" ^
                                            -w /usr/src/mymaven ^
                                            maven:3.9-eclipse-temurin-17 ^
                                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar ^
                                            -Dsonar.projectKey=paymatrix-java-backend ^
                                            -Dsonar.projectName="PayMatrix Java Backend" ^
                                            -Dsonar.host.url="http://host.docker.internal:9000" ^
                                            -Dsonar.token="%SONAR_TOKEN%"
                                    '''
                                }
                            }
                        }
                    }
                }            
                stage('Sonar: Go Fraud Gateway') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\go-microservice:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-go-fraud ^
                                            -Dsonar.projectName="PayMatrix Go Fraud Gateway" ^
                                            -Dsonar.sources=.
                                    '''
                                }
                            }
                        }
                    }
                }
                stage('Sonar: Node Frontend') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\node-frontend:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-node-frontend ^
                                            -Dsonar.projectName="PayMatrix Node Frontend" ^
                                            -Dsonar.sources=. ^
                                            -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**"
                                    '''
                                }
                            }
                        }
                    }
                }
                stage('Sonar: Python Analytics') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\python-analytics:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-python-analytics ^
                                            -Dsonar.projectName="PayMatrix Python Analytics" ^
                                            -Dsonar.sources=. ^
                                            -Dsonar.exclusions="**/venv/**,**/__pycache__/**"
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('2.1 SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to SonarQube Quality Gate status: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('3. Enterprise Build & Push to ECR') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    script {
                        echo "[PayMatrix Production] Authenticating dynamically with AWS ECR..."
                        bat "aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %ECR_REGISTRY%"

                        parallel(
                            'Push Go Microservice': {
                                dir('apps/go-microservice') {
                                    bat """
                                        docker build -t paymatrix-go-fraud:${env.IMAGE_TAG} -t paymatrix-go-fraud:latest .
                                        docker tag paymatrix-go-fraud:latest ${env.ECR_REGISTRY}/paymatrix-go-fraud:${env.IMAGE_TAG}
                                        docker tag paymatrix-go-fraud:latest ${env.ECR_REGISTRY}/paymatrix-go-fraud:latest
                                        docker push ${env.ECR_REGISTRY}/paymatrix-go-fraud:${env.IMAGE_TAG}
                                        docker push ${env.ECR_REGISTRY}/paymatrix-go-fraud:latest
                                    """
                                }
                            },
                            'Push Node Frontend': {
                                dir('apps/node-frontend') {
                                    bat """
                                        docker build -t paymatrix-node-frontend:${env.IMAGE_TAG} -t paymatrix-node-frontend:latest .
                                        docker tag paymatrix-node-frontend:latest ${env.ECR_REGISTRY}/paymatrix-node-frontend:${env.IMAGE_TAG}
                                        docker tag paymatrix-node-frontend:latest ${env.ECR_REGISTRY}/paymatrix-node-frontend:latest
                                        docker push ${env.ECR_REGISTRY}/paymatrix-node-frontend:${env.IMAGE_TAG}
                                        docker push ${env.ECR_REGISTRY}/paymatrix-node-frontend:latest
                                    """
                                }
                            },
                            'Push Java Backend': {
                                dir('apps/java-backend') {
                                    bat """
                                        docker build -t paymatrix-java-backend:${env.IMAGE_TAG} -t paymatrix-java-backend:latest .
                                        docker tag paymatrix-java-backend:latest ${env.ECR_REGISTRY}/paymatrix-java-backend:${env.IMAGE_TAG}
                                        docker tag paymatrix-java-backend:latest ${env.ECR_REGISTRY}/paymatrix-java-backend:latest
                                        docker push ${env.ECR_REGISTRY}/paymatrix-java-backend:${env.IMAGE_TAG}
                                        docker push ${env.ECR_REGISTRY}/paymatrix-java-backend:latest
                                    """
                                }
                            },
                            'Push Python Analytics': {
                                dir('apps/python-analytics') {
                                    bat """
                                        docker build -t paymatrix-python-analytics:${env.IMAGE_TAG} -t paymatrix-python-analytics:latest .
                                        docker tag paymatrix-python-analytics:latest ${env.ECR_REGISTRY}/paymatrix-python-analytics:${env.IMAGE_TAG}
                                        docker tag paymatrix-python-analytics:latest ${env.ECR_REGISTRY}/paymatrix-python-analytics:latest
                                        docker push ${env.ECR_REGISTRY}/paymatrix-python-analytics:${env.IMAGE_TAG}
                                        docker push ${env.ECR_REGISTRY}/paymatrix-python-analytics:latest
                                    """
                                }
                            }
                        )
                    }
                }
            }
        }

        stage('4. Trivy Security Scan') {
            parallel {
                stage('Trivy Scan: Java Backend') {
                    steps {
                        script {
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 --format table ${env.ECR_REGISTRY}/paymatrix-java-backend:latest"
                        }
                    }
                }
                stage('Trivy Scan: Go Microservice') {
                    steps {
                        script {
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 --format table ${env.ECR_REGISTRY}/paymatrix-go-fraud:latest"
                        }
                    }
                }
                stage('Trivy Scan: Node Frontend') {
                    steps {
                        script {
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 --format table ${env.ECR_REGISTRY}/paymatrix-node-frontend:latest"
                        }
                    }
                }
                stage('Trivy Scan: Python Analytics') {
                    steps {
                        script {
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 --format table ${env.ECR_REGISTRY}/paymatrix-python-analytics:latest"
                        }
                    }
                }
            }
        }

    post {
        always {
            echo "[PayMatrix Post-Action] Archiving Security Scan Reports..."
            archiveArtifacts artifacts: 'trivy-reports/*.txt', allowEmptyArchive: true
        }
        success {
            echo "[PayMatrix Post-Action] SUCCESS: Production pipeline complete. Images pushed and scanned successfully!"
        }
        failure {
            echo "[PayMatrix Post-Action] FAILURE: Pipeline failed during quality gate, push, or scan."
        }
        cleanup {
            echo "[PayMatrix Post-Action] Cleaning up workspace and local container cache..."
            cleanWs notFailBuild: true
            bat "docker image prune -f || exit 0"
        }
    }
}