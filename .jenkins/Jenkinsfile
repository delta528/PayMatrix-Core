pipeline {
    agent any

    environment {
        IMAGE_TAG = "${BUILD_NUMBER}"
        SCAN_REPORT_DIR = "${WORKSPACE}\\trivy-reports"
        SONARQUBE_SERVER = 'SonarQube'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
    }

    stages {

        stage('1. Checkout & Setup') {
            steps {
                checkout scm
                script {
                    try {
                        def gitSha = bat(
                            script: '@echo off & git rev-parse --short HEAD', 
                            returnStdout: true
                        ).trim()
                        
                        if (gitSha && gitSha != "null" && !gitSha.contains("cmd.exe")) {
                            env.IMAGE_TAG = gitSha
                        }
                    } catch (Exception e) {
                        echo "[Warning] Could not get Git SHA. Falling back to BUILD_NUMBER."
                    }

                    echo "[PayMatrix] Using Target Image Tag: ${env.IMAGE_TAG}"
                    bat "if not exist \"${env.SCAN_REPORT_DIR}\" mkdir \"${env.SCAN_REPORT_DIR}\""
                }
            }
        }

        stage('2. SonarQube Code Quality') {
            parallel {
                stage('Sonar: Java Backend') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\java-backend:/usr/src/mymaven" ^
                                            -v "%USERPROFILE%\\.m2:/root/.m2" ^
                                            -w /usr/src/mymaven ^
                                            maven:3.9-eclipse-temurin-17 ^
                                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar ^
                                            -Dsonar.projectKey=paymatrix-java-backend ^
                                            -Dsonar.projectName="PayMatrix Java Backend" ^
                                            -Dsonar.host.url="http://host.docker.internal:9000" ^
                                            -Dsonar.token="%SONAR_TOKEN%"
                                    '''
                                }
                            }
                        }
                    }
                }            
                stage('Sonar: Go Fraud Gateway') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\go-microservice:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-go-fraud ^
                                            -Dsonar.projectName="PayMatrix Go Fraud Gateway" ^
                                            -Dsonar.sources=.
                                    '''
                                }
                            }
                        }
                    }
                }
                stage('Sonar: Node Frontend') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\node-frontend:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-node-frontend ^
                                            -Dsonar.projectName="PayMatrix Node Frontend" ^
                                            -Dsonar.sources=. ^
                                            -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**"
                                    '''
                                }
                            }
                        }
                    }
                }
                stage('Sonar: Python Analytics') {
                    steps {
                        script {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                                    bat '''
                                        docker run --rm ^
                                            -v "%WORKSPACE%\\apps\\python-analytics:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-python-analytics ^
                                            -Dsonar.projectName="PayMatrix Python Analytics" ^
                                            -Dsonar.sources=. ^
                                            -Dsonar.exclusions="**/venv/**,**/__pycache__/**"
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }
        
        stage('2.1 SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Pipeline aborted due to SonarQube Quality Gate status: ${qg.status}"
                        }
                    }
                }
            }
        }

        // --- MOVED UP: Build and push to ECR with Kaniko first ---
        stage('3. Kaniko Build and Push to ECR') {
            parallel {
                stage('Push Go Microservice') {
                    steps {
                        container('kaniko') {
                            sh '''
                                /kaniko/executor \
                                  --context="${WORKSPACE}/apps/go-microservice" \
                                  --dockerfile="${WORKSPACE}/apps/go-microservice/Dockerfile" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-go-microservice:${env.IMAGE_TAG}" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-go-microservice:latest" \
                                  --cache=true 
                            '''
                        }
                    }
                }
                stage('Push Node Frontend') {
                    steps {
                        container('kaniko') {
                            sh '''
                                /kaniko/executor \
                                  --context="${WORKSPACE}/apps/node-frontend" \
                                  --dockerfile="${WORKSPACE}/apps/node-frontend/Dockerfile" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-node-frontend:${env.IMAGE_TAG}" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-node-frontend:latest" \
                                  --cache=true 
                            '''
                        }
                    }
                }
                stage('Push Java Backend') {
                    steps {
                        container('kaniko') {
                            sh '''
                                /kaniko/executor \
                                  --context="${WORKSPACE}/apps/java-backend" \
                                  --dockerfile="${WORKSPACE}/apps/java-backend/Dockerfile" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-java-backend:${env.IMAGE_TAG}" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-java-backend:latest" \
                                  --cache=true 
                            '''
                        }
                    }
                }
                stage('Push Python Analytics') {
                    steps {
                        container('kaniko') {
                            sh '''
                                /kaniko/executor \
                                  --context="${WORKSPACE}/apps/python-analytics" \
                                  --dockerfile="${WORKSPACE}/apps/python-analytics/Dockerfile" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-python-analytics:${env.IMAGE_TAG}" \
                                  --destination="074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-python-analytics:latest" \
                                  --cache=true 
                            '''
                        }
                    }
                }
            }
        }

        // --- MOVED DOWN: Scan images directly from ECR after successful pushed ---
        stage('4. Trivy Security Scan') {
            parallel {
                stage('Trivy Scan: Java Backend') {
                    steps {
                        script {
                            bat "cmd /c trivy image --severity HIGH,CRITICAL --exit-code 0 074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-java-backend:latest > \"%WORKSPACE%\\trivy-reports\\java-backend-trivy.txt\""
                        }
                    }
                }
                stage('Trivy Scan: Go Microservice') {
                    steps {
                        script {
                            bat "cmd /c trivy image --severity HIGH,CRITICAL --exit-code 0 074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-go-microservice:latest > \"%WORKSPACE%\\trivy-reports\\go-fraud-trivy.txt\""
                        }
                    }
                }
                stage('Trivy Scan: Node Frontend') {
                    steps {
                        script {
                            bat "cmd /c trivy image --severity HIGH,CRITICAL --exit-code 0 074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-node-frontend:latest > \"%WORKSPACE%\\trivy-reports\\node-frontend-trivy.txt\""
                        }
                    }
                }
                stage('Trivy Scan: Python Analytics') {
                    steps {
                        script {
                            bat "cmd /c trivy image --severity HIGH,CRITICAL --exit-code 0 074926209680.dkr.ecr.us-west-2.amazonaws.com/paymatrix-python-analytics:latest > \"%WORKSPACE%\\trivy-reports\\python-analytics-trivy.txt\""
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "[PayMatrix Post-Action] Archiving Security Scan Reports..."
            archiveArtifacts artifacts: 'trivy-reports/*.txt', allowEmptyArchive: true
        }
        success {
            echo "[PayMatrix Post-Action] SUCCESS: All 4 microservices built, pushed to ECR via Kaniko, and scanned!"
        }
        failure {
            echo "[PayMatrix Post-Action] FAILURE: Build failed due to Quality Gate or Security violations."
        }
        cleanup {
            echo "[PayMatrix Post-Action] Cleaning up temporary workspace files..."
            cleanWs notFailBuild: true
        }
    }
}