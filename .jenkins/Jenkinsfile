pipeline {
    agent any

    environment {
        // Fallback default tag using BUILD_NUMBER
        IMAGE_TAG = "${BUILD_NUMBER}"
        SCAN_REPORT_DIR = "${WORKSPACE}\\trivy-reports"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
    }

    stages {

        stage('1. Checkout & Setup') {
            steps {
                checkout scm
                script {
                    try {
                        // Extract short Git SHA safely on Windows
                        def gitSha = bat(
                            script: '@echo off & git rev-parse --short HEAD', 
                            returnStdout: true
                        ).trim()
                        
                        if (gitSha && gitSha != "null" && !gitSha.contains("cmd.exe")) {
                            env.IMAGE_TAG = gitSha
                        }
                    } catch (Exception e) {
                        echo "[Warning] Could not get Git SHA. Falling back to BUILD_NUMBER."
                    }

                    echo "[PayMatrix] Using Target Image Tag: ${env.IMAGE_TAG}"

                    // Create Trivy report output folder
                    bat "if not exist \"${env.SCAN_REPORT_DIR}\" mkdir \"${env.SCAN_REPORT_DIR}\""
                }
            }
        }

        stage('2. SonarQube Code Quality') {
            parallel {

                stage('Sonar: Java Backend') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning Java Backend..."
                            dir('apps/java-backend') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    withSonarQubeEnv('SonarQube') {
                                        bat 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=paymatrix-java-backend -Dsonar.projectName="PayMatrix Java Backend" -Dsonar.host.url=http://127.0.0.1:9000 -Dsonar.token=%SONAR_TOKEN%'
                                    }
                                }
                            }
                        }
                    }
                }
            
                stage('Sonar: Go Fraud Gateway') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning Go Fraud Gateway..."
                            dir('apps/go-microservice') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    withSonarQubeEnv('SonarQube') {
                                        bat '''
                                            docker run --rm ^
                                            -v "%CD%:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-go-fraud ^
                                            -Dsonar.projectName="PayMatrix Go Fraud Gateway" ^
                                            -Dsonar.sources=.
                                        '''
                                    }
                                }
                            }
                        }
                    }
                }
                stage('Sonar: Node Frontend') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning Node Frontend..."
                            dir('apps/node-frontend') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    withSonarQubeEnv('SonarQube') {
                                        bat '''
                                            docker run --rm ^
                                            -v "%CD%:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-node-frontend ^
                                            -Dsonar.projectName="PayMatrix Node Frontend" ^
                                            -Dsonar.sources=. ^
                                            -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/build/**"
                                        '''
                                    }
                                }
                            }
                        }
                    }
                }
                                    
                stage('Sonar: Python Analytics') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning Python Analytics..."
                            dir('apps/python-analytics') {
                                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                    withSonarQubeEnv('SonarQube') {
                                        bat '''
                                            docker run --rm ^
                                            -v "%CD%:/usr/src" ^
                                            -e SONAR_HOST_URL="http://host.docker.internal:9000" ^
                                            -e SONAR_TOKEN="%SONAR_TOKEN%" ^
                                            sonarsource/sonar-scanner-cli ^
                                            -Dsonar.projectKey=paymatrix-python-analytics ^
                                            -Dsonar.projectName="PayMatrix Python Analytics" ^
                                            -Dsonar.sources=. ^
                                            -Dsonar.exclusions="**/venv/**,**/__pycache__/**"
                                        '''
                                    }
                                }
                            }
                        }
                    }
                }

            }
        }

        stage('3. Build Docker Images') {
            parallel {

                stage('Build Java Backend') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-java-backend:${env.IMAGE_TAG}..."
                            dir('apps/java-backend') {
                                bat "docker build -t paymatrix-java-backend:${env.IMAGE_TAG} -t paymatrix-java-backend:latest ."
                            }
                        }
                    }
                }

                stage('Build Go Fraud Gateway') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-go-fraud:${env.IMAGE_TAG}..."
                            dir('apps/go-microservice') {
                                bat "docker build -t paymatrix-go-fraud:${env.IMAGE_TAG} -t paymatrix-go-fraud:latest ."
                            }
                        }
                    }
                }

                stage('Build Node Frontend') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-node-frontend:${env.IMAGE_TAG}..."
                            dir('apps/node-frontend') {
                                bat "docker build -t paymatrix-node-frontend:${env.IMAGE_TAG} -t paymatrix-node-frontend:latest ."
                            }
                        }
                    }
                }

                stage('Build Python Analytics') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-python-analytics:${env.IMAGE_TAG}..."
                            dir('apps/python-analytics') {
                                bat "docker build -t paymatrix-python-analytics:${env.IMAGE_TAG} -t paymatrix-python-analytics:latest ."
                            }
                        }
                    }
                }

            }
        }

        stage('4. Trivy Security Scan') {
            parallel {

                stage('Trivy Scan: Java Backend') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-java-backend:${env.IMAGE_TAG}..."
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-java-backend:${env.IMAGE_TAG} > \"${env.SCAN_REPORT_DIR}\\java-backend-trivy.txt\""
                        }
                    }
                }

                stage('Trivy Scan: Go Fraud Gateway') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-go-fraud:${env.IMAGE_TAG}..."
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-go-fraud:${env.IMAGE_TAG} > \"${env.SCAN_REPORT_DIR}\\go-fraud-trivy.txt\""
                        }
                    }
                }

                stage('Trivy Scan: Node Frontend') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-node-frontend:${env.IMAGE_TAG}..."
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-node-frontend:${env.IMAGE_TAG} > \"${env.SCAN_REPORT_DIR}\\node-frontend-trivy.txt\""
                        }
                    }
                }

                stage('Trivy Scan: Python Analytics') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-python-analytics:${env.IMAGE_TAG}..."
                            bat "trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-python-analytics:${env.IMAGE_TAG} > \"${env.SCAN_REPORT_DIR}\\python-analytics-trivy.txt\""
                        }
                    }
                }

            }
        }

    }

    post {
        always {
            echo "[PayMatrix Post-Action] Archiving Security Scan Reports..."
            archiveArtifacts artifacts: 'trivy-reports/*.txt', allowEmptyArchive: true
        }
        success {
            echo "[PayMatrix Post-Action] SUCCESS: All 4 microservices built and verified!"
        }
        failure {
            echo "[PayMatrix Post-Action] FAILURE: Build failed. Check logs above."
        }
        cleanup {
            echo "[PayMatrix Post-Action] Cleaning up temporary Docker images..."
            bat "docker image prune -f --filter \"until=24h\" || exit 0"
        }
    }
}