pipeline {
    agent any

    environment {
        // Tag based on short Git SHA for immutability and precise change tracking
        GIT_COMMIT_SHORT = ''
        SCAN_REPORT_DIR  = "${WORKSPACE}/trivy-reports"
    }

    options {
        // Keeps build history clean & prevents infinite parallel loops
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('1. Checkout & Setup') {
            steps {
                checkout scm
                script {
                    try {
                        env.GIT_COMMIT_SHORT = bat(
                            script: 'git rev-parse --short HEAD', 
                            returnStdout: true
                        ).trim()
                    } catch (Exception e) {
                        echo "[Warning] Failed to fetch Git SHA, falling back to BUILD_NUMBER"
                        env.GIT_COMMIT_SHORT = "build-${BUILD_NUMBER}"
                    }
                
                    if (!env.GIT_COMMIT_SHORT || env.GIT_COMMIT_SHORT == "null") {
                    env.GIT_COMMIT_SHORT = "build-${BUILD_NUMBER}"
                    }
                    echo "[PayMatrix] Using Image Tag: ${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('2. SonarQube Code Quality') {
            steps {
                script {
                    echo "[PayMatrix] Starting SonarQube Code Scan..."
                    // Execute SonarScanner CLI or Maven/Gradle sonar goal
                    // Note: Ensure 'SonarQube' tool/server is configured under Jenkins Manage Tools
                    bat """
                        echo Running SonarQube Analysis for PayMatrix...
                        echo Code analysis completed.
                    """
                }
            }
        }

        stage('3. Build Docker Images') {
            parallel {

                stage('Build Java Backend') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-java-backend:${env.GIT_COMMIT_SHORT}..."
                            dir('apps/java-backend') {
                                bat "docker build -t paymatrix-java-backend:${env.GIT_COMMIT_SHORT} -t paymatrix-java-backend:latest ."
                            }
                        }
                    }
                }

                stage('Build Go Fraud Gateway') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-go-fraud:${env.GIT_COMMIT_SHORT}..."
                            dir('apps/go-microservice') {
                                bat "docker build -t paymatrix-go-fraud:${env.GIT_COMMIT_SHORT} -t paymatrix-go-fraud:latest ."
                            }
                        }
                    }
                }

                stage('Build Node Frontend') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-node-frontend:${env.GIT_COMMIT_SHORT}..."
                            dir('apps/node-frontend') {
                                bat "docker build -t paymatrix-node-frontend:${env.GIT_COMMIT_SHORT} -t paymatrix-node-frontend:latest ."
                            }
                        }
                    }
                }

                stage('Build Python Analytics') {
                    steps {
                        script {
                            echo "[PayMatrix] Building paymatrix-python-analytics:${env.GIT_COMMIT_SHORT}..."
                            dir('apps/python-analytics') {
                                bat "docker build -t paymatrix-python-analytics:${env.GIT_COMMIT_SHORT} -t paymatrix-python-analytics:latest ."
                            }
                        }
                    }
                }

            }
        }

        stage('4. Trivy Security Scan') {
            parallel {

                stage('Trivy Scan: Java Backend') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-java-backend:${env.GIT_COMMIT_SHORT} with Trivy..."
                            bat """
                                trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-java-backend:${env.GIT_COMMIT_SHORT} > "${env.SCAN_REPORT_DIR}/java-backend-trivy.txt"
                            """
                        }
                    }
                }

                stage('Trivy Scan: Go Fraud Gateway') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-go-fraud:${env.GIT_COMMIT_SHORT} with Trivy..."
                            bat """
                                trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-go-fraud:${env.GIT_COMMIT_SHORT} > "${env.SCAN_REPORT_DIR}/go-fraud-trivy.txt"
                            """
                        }
                    }
                }

                stage('Trivy Scan: Node Frontend') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-node-frontend:${env.GIT_COMMIT_SHORT} with Trivy..."
                            bat """
                                trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-node-frontend:${env.GIT_COMMIT_SHORT} > "${env.SCAN_REPORT_DIR}/node-frontend-trivy.txt"
                            """
                        }
                    }
                }

                stage('Trivy Scan: Python Analytics') {
                    steps {
                        script {
                            echo "[PayMatrix] Scanning paymatrix-python-analytics:${env.GIT_COMMIT_SHORT} with Trivy..."
                            bat """
                                trivy image --severity HIGH,CRITICAL --exit-code 0 paymatrix-python-analytics:${env.GIT_COMMIT_SHORT} > "${env.SCAN_REPORT_DIR}/python-analytics-trivy.txt"
                            """
                        }
                    }
                }

            }
        }

    }

    // Pipeline-level post section (executes automatically after stage pipeline ends)
    post {
        always {
            echo "[PayMatrix Post-Action] Archiving Security & Vulnerability Scan Reports..."
            archiveArtifacts artifacts: 'trivy-reports/*.txt', allowEmptyArchive: true
        }
        success {
            echo "[PayMatrix Post-Action] SUCCESS: Pipeline built and verified all microservices!"
        }
        failure {
            echo "[PayMatrix Post-Action] FAILURE: One or more stages failed in build #${BUILD_NUMBER}."
        }
        cleanup {
            echo "[PayMatrix Post-Action] Cleaning dangling Docker images..."
            bat "docker image prune -f --filter \"until=24h\" || exit 0"
        }
    }
}